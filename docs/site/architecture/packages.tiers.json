    "lab/contracts": {
      "tier": "host",
      "status": "SUPP",
      "purpose": "Registry of external contracts (file layouts, wires, grammars): name, major version and pinned golden hashes."
    },
    "lab/draft/draftlab": {
      "tier": "bots",
      "status": "EXT",
      "purpose": "Training composition API over the draft stack: open packs, draft, build, play, gauntlet and whole events with named, versioned built-in agents; every call a pure function of inputs and seed; 17Lands-shaped artifacts."
    },
    "lab/draft/draftlab/extern": {
      "tier": "bots",
      "status": "EXT",
      "purpose": "Out-of-process agents for draftlab: dial an agent over a child's stdio or a Unix socket, batch its requests across concurrent games, and expose it as a Drafter, Builder and Player."
    },
    "lab/draft/draftlab/extern/refagent": {
      "tier": "bots",
      "status": "TOOL",
      "purpose": "Reference gorge-agent/1 agent (uniform random, first legal) for tests, benchmarks and as a worked example."
    },
    "lab/draft/draftlab/extern/wire": {
      "tier": "bots",
      "status": "EXT",
      "purpose": "The gorge-agent/1 wire: JSON-lines messages an out-of-process drafter, builder or player speaks, carrying view.View, decision.Intent and protocol.DraftCard."
    },
