{
  "tiers": [
    {
      "id": "core",
      "title": "T0 card pipeline and T1 rules core",
      "intro": "The card compiler, the event-sourced state and the rules engine itself."
    },
    {
      "id": "host",
      "title": "T2 projection, host and wire",
      "intro": "What a client or server sees: the per-seat view, seats, the wire protocol and the host."
    },
    {
      "id": "bots",
      "title": "T3 bots, ML and search",
      "intro": "Hosted bot policies and the optional learned, search and SpellBench extensions."
    },
    {
      "id": "tooling",
      "title": "T4 tooling",
      "intro": "Ratchets, test support, code generators and the compliance pipeline."
    },
    {
      "id": "cmd",
      "title": "Commands (`cmd/`)",
      "intro": "Binaries. No package imports a command."
    }
  ],
