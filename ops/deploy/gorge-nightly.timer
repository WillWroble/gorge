# Fires gorge-nightly.service at 03:30 local time daily. Install instructions:
# the header of deploy/gorge-nightly.service.
[Unit]
Description=Run the gorge nightly tier daily at 03:30

[Timer]
OnCalendar=*-*-* 03:30:00
# Catch up after a suspend or a reboot instead of silently skipping the night.
Persistent=true
AccuracySec=1min
Unit=gorge-nightly.service

[Install]
WantedBy=timers.target
